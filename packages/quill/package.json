{
  "name": "@posthog/quill-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && pnpm --filter @posthog/quill-web dev",
    "storybook": "pnpm --filter @posthog/quill-tokens build && pnpm --filter @posthog/quill-storybook storybook",
